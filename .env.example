# Copy to .env (gitignored) and fill in for `docker compose run harness ...`.
# REAPER_URL is the operator dashboard; REAPER_C2_URL is the beacon listener
# (they must differ). REAPER_ENGAGEMENT scopes the run to that workspace.
# All of these can also be passed as --reaper-* / --engagement flags.

REAPER_URL=https://c2.example.com:8443
REAPER_C2_URL=https://c2.example.com:8080
REAPER_USERNAME=
REAPER_PASSWORD=
REAPER_ENGAGEMENT=

# Required for the claude CLI to authenticate non-interactively inside the
# container (no browser available for an OAuth login flow there).
ANTHROPIC_API_KEY=
